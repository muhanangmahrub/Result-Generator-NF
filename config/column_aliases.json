{
  "_comment": [
    "Default header aliases for Result Test Generator.",
    "Aliases are matched against NORMALISED header text: lowercase, punctuation",
    "replaced by spaces, whitespace collapsed, runs of single letters glued",
    "together. Example: 'Pass/Fail (P/F)' -> 'pass fail pf'.",
    "Column position / letter is never used.",
    "To customise, copy this file to <project>/config/column_aliases.json and",
    "edit it; your entries are merged on top of these defaults."
  ],

  "header_scan_rows": 30,
  "max_blank_rows": 10,
  "metadata_scan_columns": 10,

  "required_fields": ["test_case_id", "test_case", "test_step"],

